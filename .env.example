# Database Connection (PostgreSQL)
DB_URL="postgresql://postgres:postgres@localhost:5432/ticket_booking?schema=public"

# Redis Connection
REDIS_URL="redis://localhost:6379"

# JWT Auth Secret
JWT_SECRET="super-secret-jwt-signing-key-change-in-production"

# Seat Hold TTL in seconds (Default is 10 minutes = 600s)
SEAT_HOLD_TTL_SECONDS=600

# Email API Key (Resend / Nodemailer config)
EMAIL_API_KEY="re_123456789"
EMAIL_FROM="tickets@yourdomain.com"

# Frontend and Backend URLs
PORT=5000
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:5000"
